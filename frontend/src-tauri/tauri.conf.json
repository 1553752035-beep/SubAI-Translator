{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubAI Translator",
  "version": "2.0.0",
  "identifier": "com.subai.translator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SubAI Translator v2.0",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/subai-backend"
    ],
    "resources": [
      "models/**/*",
      "bin/**/*"
    ]
  }
}
