{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubAI Translator",
  "version": "4.1.0",
  "identifier": "com.subai.translator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SubAI Translator v4.1",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/subai-backend"
    ],
    "resources": [
      "models/**/*",
      "bin/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NDc2NjA0RTVFMkNBMUYKUldRZnl1TGxCR1pIbVM5cEFITnJpYW9XdWNTcExlT01aZjVpVDRzY2xvK2ZiTFVSWHVxYlluZEcK",
      "endpoints": [
        "https://github.com/1553752035-beep/SubAI-Translator/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
