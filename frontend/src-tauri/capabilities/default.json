{
  "$schema": "https://schema.tauri.app/capabilities/2",
  "identifier": "default",
  "description": "默认权限：允许应用自身的全部自定义命令",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:default"
  ]
}
