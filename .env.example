# SubAI Translator —— Docker Compose 环境变量示例
# 复制本文件为 .env 后按需修改，切勿提交真实密钥到版本库。

# 服务端口（宿主机映射端口）
SUBAI_SERVER_PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
SUBAI_LOG_LEVEL=INFO

# 翻译模式：local / cloud / hybrid
SUBAI_LLM_MODE=local
# 本地 LLM 地址（容器内访问宿主机用 host.docker.internal）
SUBAI_LLM_LOCAL_URL=http://host.docker.internal:5001/v1/chat/completions
SUBAI_LLM_LOCAL_MODEL=koboldcpp

# JWT 密钥与管理员凭据（生产环境务必修改）
SUBAI_AUTH_JWT_SECRET=please-change-me-in-production
SUBAI_AUTH_ADMIN_USERNAME=admin
SUBAI_AUTH_ADMIN_PASSWORD=admin123

# 备份
SUBAI_BACKUP_ENABLED=true
SUBAI_BACKUP_AUTO_BACKUP_INTERVAL_HOURS=24
