# SubAI Translator 环境配置模板（二期）
# =========================================
# 复制此文件为 .env 并填入实际值
# 所有配置项都可以通过环境变量覆盖（格式：SUBAI_<SECTION>_<KEY>）

# --------------------------------------------------------------------------- #
# ASR配置（语音识别）
# --------------------------------------------------------------------------- #

# ASR设备：auto=自动检测, cuda=GPU, cpu=CPU
# auto模式会检查显存，如果≥4GB则使用cuda
SUBAI_ASR_DEVICE=auto

# 计算类型：auto=自动, float16=GPU高精度, int8=CPU低精度
SUBAI_ASR_COMPUTE_TYPE=auto

# 束搜索大小（影响识别准确率，越大越慢）
SUBAI_ASR_BEAM_SIZE=5

# 批量处理大小（影响内存使用）
SUBAI_ASR_BATCH_SIZE=8

# CPU推理线程数（仅device=cpu时生效）
SUBAI_ASR_CPU_THREADS=8

# 是否启用语音活动检测（过滤静音段）
SUBAI_ASR_VAD_FILTER=true

# 是否返回单词级时间戳
SUBAI_ASR_WORD_TIMESTAMPS=true

# --------------------------------------------------------------------------- #
# LLM配置（翻译服务）
# --------------------------------------------------------------------------- #

# 翻译模式：local=本地koboldcpp, cloud=云端API, hybrid=混合(ASR本地GPU+翻译云端)
# 注意：切换模式需要重启服务
# - local: 所有数据本地处理，隐私性好，但翻译速度慢
# - cloud: 翻译走云端API，速度快，但有隐私风险
# - hybrid: ASR使用本地GPU，翻译走云端（推荐，性能最优）
SUBAI_LLM_MODE=local

# 本地LLM配置（koboldcpp）
SUBAI_LLM_LOCAL_URL=http://127.0.0.1:5001/v1/chat/completions
SUBAI_LLM_LOCAL_MODEL=koboldcpp

# 云端LLM配置（OpenAI兼容接口）
# 如果使用cloud或hybrid模式，必须配置以下两项
SUBAI_LLM_CLOUD_URL=
SUBAI_LLM_CLOUD_API_KEY=
SUBAI_LLM_CLOUD_MODEL=gpt-4o

# 翻译请求超时时间（秒）
SUBAI_LLM_TIMEOUT=180

# 最大输出token数
SUBAI_LLM_MAX_TOKENS=256

# 翻译温度参数（越低越稳定）
SUBAI_LLM_TEMPERATURE=0.2

# 批量翻译大小
SUBAI_LLM_BATCH_SIZE=8

# 最大重试次数
SUBAI_LLM_MAX_RETRIES=3

# 重试初始延迟（秒，指数退避：1s, 2s, 4s）
SUBAI_LLM_RETRY_DELAY=1.0

# --------------------------------------------------------------------------- #
# OCR配置（硬字幕识别）
# --------------------------------------------------------------------------- #

# 采样帧率（帧/秒）
SUBAI_OCR_SAMPLE_FPS=2.0

# 最低置信度阈值
SUBAI_OCR_MIN_SCORE=0.5

# 时间戳合并容忍度（秒）
SUBAI_OCR_GAP_TOL=0.8

# --------------------------------------------------------------------------- #
# 服务器配置
# --------------------------------------------------------------------------- #

# 监听地址
SUBAI_SERVER_HOST=0.0.0.0

# 监听端口
SUBAI_SERVER_PORT=8000

# CORS允许的来源（逗号分隔，*表示允许所有）
SUBAI_SERVER_CORS_ORIGINS=*

# 开发模式是否自动重载
SUBAI_SERVER_RELOAD=false

# --------------------------------------------------------------------------- #
# 并发配置
# --------------------------------------------------------------------------- #

# 本地模式最大并发数（受内存限制，默认2）
SUBAI_CONCURRENCY_LOCAL_MAX_CONCURRENT=2

# 云端/混合模式最大并发数（内存充足，默认4）
SUBAI_CONCURRENCY_CLOUD_MAX_CONCURRENT=4

# 任务队列最大长度
SUBAI_CONCURRENCY_MAX_QUEUE_SIZE=100

# 最大内存使用量（GB）
SUBAI_CONCURRENCY_MAX_MEMORY_USAGE_GB=16.0

# --------------------------------------------------------------------------- #
# 缓存配置
# --------------------------------------------------------------------------- #

# 缓存数据库路径（默认在项目data目录）
# SUBAI_CACHE_DB_PATH=data/translation_cache.db

# 最大缓存条目数
SUBAI_CACHE_MAX_ENTRIES=10000

# 缓存有效期（天）
SUBAI_CACHE_TTL_DAYS=30

# 淘汰策略：lru=最近最少使用, lfu=最不经常使用, fifo=先进先出
SUBAI_CACHE_EVICTION_POLICY=lru

# --------------------------------------------------------------------------- #
# 其他配置
# --------------------------------------------------------------------------- #

# 字幕切分阈值（每行最大字符数）
SUBAI_MAX_CHARS=20

# 字幕切分阈值（每行最大时长，秒）
SUBAI_MAX_DUR=6.0

# 断句标点
SUBAI_BREAK_PUNCT=。！？!?…；;，,、