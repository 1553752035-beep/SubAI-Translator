# ===== Python 运行时与缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== 本地模型（大文件，用 tools/fetch_ct2_model.ps1 重新获取）=====
models/
frontend/src-tauri/models/
*.gguf
*.safetensors

# ===== 前端 / Node 依赖与产物 =====
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ===== Tauri / Rust 产物与外部二进制 =====
frontend/src-tauri/target/
frontend/src-tauri/gen/
frontend/src-tauri/binaries/
frontend/src-tauri/bin/

# ===== Python 打包产物（PyInstaller）=====
/build/
/dist/
/bin/
subai-backend.exe
*.manifest

# ===== 运行产物 =====
output/
output-backup/
logs/
data/*.wav
data/*.png
data/uploads/
*.db
build_log.txt

# ===== 环境变量与密钥 =====
.env
.env.*
!.env.example

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
*.log

# 插件系统（四期 4.3）：运行时状态与用户插件目录不入库
data/plugins.json
/plugins/
# 更新签名私钥绝不入库（私钥在用户的 .tauri 目录）
*.key
*.key.pub

# 更新产物（构建物，随 Release 分发而非入库）
*.nsis.zip

# ===== 语料与自动发现产物（2026-10-25）=====
# corpus/ 是本地积累的参考字幕（用户视频转录结果），属于私人素材，不入库。
# data/known_terms.json 由术语自动发现生成，随语料变化，不入库。
corpus/
data/known_terms.json

# sherpa 模型（446 MB，按需下载或从发布包获取）
models/sherpa/
*.nsis.zip.sig

# 运行期产物：数据库、缓存、探测结果、临时音频，都不入库
data/*.db
data/*.json
data/*.wav
data/*.mp4
data/*.png
data/*.txt
# 例外：需要随仓库分发的配置/词表模板
!data/sample_terms.json

# 本地访问令牌：首次启动自动生成，每台机器不同，绝不入库
local_token.txt
